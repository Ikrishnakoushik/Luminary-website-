{
  "env": {
    "node": true,
    "browser": true,
    "es2021": true
  },
  "plugins": [
    "html"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-empty": "warn",
    "no-unreachable": "error",
    "no-dupe-keys": "error"
  }
}
